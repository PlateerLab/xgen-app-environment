{
  "name": "fastapi-react",
  "version": 1,
  "service": {
    "install": "pip install -r backend/requirements.txt && npm --prefix frontend ci --prefer-offline --no-audit --no-fund",
    "build": "npm --prefix frontend run build",
    "command": "uvicorn backend.serve:app --host 0.0.0.0 --port $PORT",
    "health": "/api/health"
  },
  "install_files": [
    "backend/requirements.txt",
    "frontend/package-lock.json"
  ]
}
